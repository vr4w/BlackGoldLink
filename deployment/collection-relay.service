[Unit]
Description=Collection Relay web (independent from AE Portal)
After=network.target

[Service]
User=collection-relay
Group=collection-relay
WorkingDirectory=/srv/collection-relay/current
EnvironmentFile=/etc/collection-relay.env
ExecStart=/srv/collection-relay/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5013 --timeout 60 'app:create_app()'
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/collection-relay
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target

# Replace __HOSTNAME__ with the confirmed new subdomain. Dedicated file only.
# Initial HTTP configuration for certificate provisioning; finalize HTTPS with certbot.
server {
    listen 80;
    server_name __HOSTNAME__;
    client_max_body_size 16k;
    # OAuth query strings contain temporary credentials: never log request URLs.
    access_log off;
    error_log /var/log/nginx/collection-relay-error.log warn;
    location / {
        proxy_pass http://127.0.0.1:5013;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 65s;
    }
    location ~ /\.(?!well-known) { deny all; }
}

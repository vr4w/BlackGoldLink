# Separate configuration. Never reuse AE-Portal keys, database or cookies.
APP_ENV=development
BASE_URL=http://127.0.0.1:5013
PORT=5013
DATABASE_PATH=/absolute/path/to/collection-relay/instance/collection.db
WORKING_TITLE="BlackGoldLink"
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
PUBLIC_SIGNUP=false
INVITE_CODE=
# Enable only after written Discogs clarification covering sharing, comparison and potential exchange leads.
MATCHING_APPROVED=false
CONTROLLER_NAME=
CONTROLLER_ADDRESS=
PRIVACY_CONTACT=
HOSTING_PROVIDER=

# Immutable Discogs account IDs; empty disables the owner panel. Never use editable BGL names.
ADMIN_DISCOGS_IDS=
